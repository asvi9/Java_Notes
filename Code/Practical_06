import java.util.Scanner;

public class TwoDimensionalArray {
public static void main(String[] args) {
    Scanner sc = new Scanner(System.in);

    int a[][] = new int [3][3];
    int b[][] = new int [3][3];
    int sum[][] = new int [3][3];

    System.out.println("Enter First Matrix: ");
    for(int i = 0; i<3; i++){
        for(int j = 0; j<3; j++){
            a[i][j] = sc.nextInt();
        }
    }
    System.out.println("Enter Second Matrix:");
        for(int i = 0; i<3; i++){
        for(int j = 0; j<3; j++){
            b[i][j] = sc.nextInt();
        }
    }
        System.out.println("\nAdd of Matrix:");
        for(int i = 0; i<3; i++){
            for(int j = 0; j<3;j++){
                sum[i][j] = a[i][j] + b[i][j];
                System.out.print(sum[i][j] + "\n");
            }
            System.out.println("");

        }
        sc.close();

}
}

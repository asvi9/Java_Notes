======================== (d) Combined Program: Abstract Class + Multiple Interfaces  ========================

abstract class Person {

    // Abstract method
    abstract void work();

    // Concrete method
    void display() {
        System.out.println("Person details");
    }
}

interface Teacher {

    void teach();
}

interface Researcher {

    void research();
}

// Inheriting abstract class and implementing two interfaces
class Professor extends Person implements Teacher, Researcher {

    @Override
    void work() {
        System.out.println("Professor is working");
    }

    @Override
    public void teach() {
        System.out.println("Professor is teaching");
    }

    @Override
    public void research() {
        System.out.println("Professor is doing research");
    }
}

public class AbstractionMultipleInheritance {

    public static void main(String[] args) {

        Professor p = new Professor();

        p.display();
        p.work();
        p.teach();
        p.research();
    }
}
